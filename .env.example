# =============================================================================
# Contract Clause Risk Analyzer — environment variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` in the project root:
#        copy .env.example .env          (Windows)
#        cp .env.example .env            (macOS/Linux)
#   2. Fill in the API key for the LLM provider you choose.
#   3. Tell the agent: ".env is ready" — do NOT paste keys into chat.
#   4. Never commit `.env` (it is gitignored).
# =============================================================================

# --- LLM provider: "xai" | "openai" | "anthropic" ---
LLM_PROVIDER=xai
LLM_MODEL=grok-4.5

# xAI / SpaceXAI (recommended default)
# Get a key: https://console.x.ai  (account: https://accounts.x.ai)
XAI_API_KEY=

# OpenAI (set LLM_PROVIDER=openai and LLM_MODEL=gpt-4o)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (set LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-4-20250514)
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Classification models ---
# Base Legal-BERT (public; downloaded on first run)
MODEL_PATH=nlpaueb/legal-bert-base-uncased
# Optional fine-tuned CUAD checkpoint (local path or HF hub id)
FINE_TUNED_MODEL_PATH=
# Optional Hugging Face token if model download is rate-limited / private
HF_TOKEN=

CONFIDENCE_THRESHOLD=0.55
MAX_SEGMENTS=100
MAX_UPLOAD_MB=15

# --- App ---
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Set true to skip loading heavy transformers (tests / CI)
SKIP_MODEL_LOAD=false
