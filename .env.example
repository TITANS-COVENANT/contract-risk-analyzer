# =============================================================================
# Contract Clause Risk Analyzer — environment variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` in the project root:
#        copy .env.example .env          (Windows)
#        cp .env.example .env            (macOS/Linux)
#   2. Fill in the API key for the LLM provider you choose.
#   3. Never commit `.env` (it is gitignored).
# =============================================================================

# --- LLM provider: "groq" | "xai" | "openai" | "anthropic" ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Groq (FREE tier — recommended, no credit card required)
# Sign up: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=

# xAI (paid)
# Get a key: https://console.x.ai
XAI_API_KEY=

# OpenAI (paid — set LLM_PROVIDER=openai and LLM_MODEL=gpt-4o)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (paid — set LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-4-5)
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Classification models ---
# Base Legal-BERT (public; downloaded on first run)
MODEL_PATH=nlpaueb/legal-bert-base-uncased
# Fine-tuned CUAD checkpoint on HuggingFace Hub (recommended — 79.9% accuracy)
FINE_TUNED_MODEL_PATH=ClauseGuard/legal-bert-cuad-clauses
# HuggingFace token — speeds up / stabilises the first ~418 MB model download
# Get one free: https://huggingface.co/settings/tokens (read access is enough)
HF_TOKEN=

CONFIDENCE_THRESHOLD=0.55
MAX_SEGMENTS=100
MAX_UPLOAD_MB=15

# --- App ---
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Set true to skip loading heavy transformers (tests / CI)
SKIP_MODEL_LOAD=false
